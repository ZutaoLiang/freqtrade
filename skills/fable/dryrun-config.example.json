{
    "max_open_trades": 6,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "dry_run": true,
    "dry_run_wallet": 100,
    "timeframe": "5m",
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "fee": 0.0005,
    "dataformat_ohlcv": "feather",
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {
            "timeout": 30000
        },
        "ccxt_async_config": {
            "aiohttp_proxy": "http://127.0.0.1:10811  # 环境相关,无代理时删掉这一项"
        },
        "pair_whitelist": [],
        "pair_blacklist": [
            ".*(UP|DOWN|BULL|BEAR)/.*",
            "AIGENSYN/USDT:USDT",
            "AMZN/USDT:USDT",
            "AZTEC/USDT:USDT",
            "BZ/USDT:USDT",
            "CAP/USDT:USDT",
            "CFG/USDT:USDT",
            "CL/USDT:USDT",
            "COIN/USDT:USDT",
            "CRCL/USDT:USDT",
            "ESP/USDT:USDT",
            "EWY/USDT:USDT",
            "GOOGL/USDT:USDT",
            "GWEI/USDT:USDT",
            "HOOD/USDT:USDT",
            "INTC/USDT:USDT",
            "KAT/USDT:USDT",
            "META/USDT:USDT",
            "MSTR/USDT:USDT",
            "NVDA/USDT:USDT",
            "OPG/USDT:USDT",
            "O/USDT:USDT",
            "PLTR/USDT:USDT",
            "PRL/USDT:USDT",
            "RE/USDT:USDT",
            "SLX/USDT:USDT",
            "ZHIPU/USDT:USDT"
        ],
        "_ft_has_params": {
            "funding_fee_candle_limit": 200
        }
    },
    "pairlists": [
        {
            "method": "VolumePairList",
            "number_assets": 300,
            "sort_key": "quoteVolume",
            "lookback_days": 30,
            "lookback_timeframe": "1d",
            "min_value": 150000000,
            "refresh_period": 86400
        },
        {
            "method": "AgeFilter",
            "min_days_listed": 10
        }
    ],
    "strategy": "FundingSkewMomentum5m",
    "internals": {
        "process_throttle_secs": 5
    },
    "initial_state": "running",
    "db_url": "sqlite:///user_data/tradesv3.funding_skew_dryrun.sqlite",
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "<openssl rand -hex 32>",
        "ws_token": "<openssl rand -hex 16>",
        "CORS_origins": [],
        "username": "<user>",
        "password": "<strong password>"
    }
}
