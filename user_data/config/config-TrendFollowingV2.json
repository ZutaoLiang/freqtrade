{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 5,
    "stake_currency": "USDT",
    "stake_amount": 20,
    "tradable_balance_ratio": 0.99,
    "amend_last_stake_amount": true,
    "fiat_display_currency": "USD",
    "timeframe": "15m",
    "dry_run": true,
    "dry_run_wallet": 100,
    "cancel_open_orders_on_exit": false,
    "fee": 0.0005,
    "trading_mode": "futures",
    "margin_mode": "isolated",

    "trade_leverage": 5,
    "trailing_stop": false,
    "custom_trailing_stop": true,
    "base_trailing_stop": 0.08,
    "base_trailing_stop_offset": 0.08,
    "base_stop_loss": 0.05,
    "use_custom_stoploss": true,
    "atr_stop_loss_multiplier": 4,
    "use_ha_candles": false,
    "trend_length": 3,
    "ma_short_length": 48,
    "ma_mid_length": 576,
    "ma_long_length": 0,
    "crossover_lookback_length": 10,
    "atr_period": 21,

    "htf": "4h",
    "supertrend_period": 21,
    "supertrend_multiplier": 3,
    "confirm_candles_htf": 3,

    "position_adjustment_enable": false,
    "addition_stake_ratio": 0.8,
    "addition_min_profit": 0.25,
    "addition_min_profit_step": 0.05,
    "addition_profit_step": 0.05,

    "long_time_low_profit_minutes": 0,
    "long_time_low_profit_max": 0.03,
    "long_time_low_profit_lower_bound": 0.01,
    "long_time_low_profit_upper_bound": 0.02,

    "long_time_stoploss_minutes": 120,
    "long_time_stoploss_profit": 0.04,

    "cooldown_candles": 0,
    "unfilledtimeout": {
        "entry": 1,
        "exit": 1,
        "exit_timeout_count": 10,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 3,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 5
    },
    "order_types": {
        "entry": "limit",
        "exit": "limit",
        "emergency_exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": true,
        "stoploss_on_exchange_interval": 60
